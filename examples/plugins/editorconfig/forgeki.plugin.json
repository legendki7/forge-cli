{
  "manifestVersion": 1,
  "id": "example.editorconfig",
  "name": "EditorConfig Example",
  "version": "0.1.0",
  "description": "A complete safe ForgeKi plugin example.",
  "author": { "name": "ForgeKi contributors" },
  "license": "MIT",
  "compatibility": { "forgeki": ">=0.3.0" },
  "supportedFrameworks": ["nextjs", "react-vite", "express"],
  "permissions": [
    "project:generate-files",
    "project:add-stack-components",
    "project:add-scanner-rules"
  ],
  "contributions": {
    "stackComponents": [
      {
        "id": "example-editorconfig",
        "name": "EditorConfig Example",
        "description": "Adds repository-wide editor defaults.",
        "category": "tooling",
        "supportedFrameworks": ["nextjs", "react-vite", "express"]
      }
    ],
    "generatedFiles": [
      {
        "path": ".editorconfig",
        "content": "root = true\n\n[*]\ncharset = utf-8\nend_of_line = lf\ninsert_final_newline = true\nindent_style = space\nindent_size = 2\n",
        "condition": { "component": "example-editorconfig" }
      }
    ],
    "scannerRules": [
      {
        "id": "example-editorconfig-file",
        "componentId": "example-editorconfig",
        "detect": { "any": [{ "file": ".editorconfig" }] }
      }
    ]
  }
}
