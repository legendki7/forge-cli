{
  "name": "@forgeki/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeKi Desktop project creation application.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legendki7/forge-cli.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm build:worker",
    "build:worker": "tsup --config tsup.worker.config.ts",
    "build:sidecar": "pnpm build:worker && node scripts/build-sidecar.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "pnpm build:sidecar && node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts vitest.config.ts scripts",
    "test": "vitest run --config vitest.config.ts",
    "check:config": "node scripts/validate-tauri-config.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:config"
  },
  "dependencies": {
    "@forgecli7/core": "workspace:*",
    "@forgecli7/plugin-docker": "workspace:*",
    "@forgecli7/plugin-github-actions": "workspace:*",
    "@forgecli7/plugins": "workspace:*",
    "@forgecli7/templates": "workspace:*",
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@yao-pkg/pkg": "^6.6.0",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3"
  }
}
