{
  "name": "@forgecli7/workspaces",
  "version": "0.2.0",
  "description": "Typed, deterministic multi-service workspace planning and generation for ForgeKi.",
  "keywords": [
    "forgeki",
    "workspace",
    "monorepo",
    "scaffolding",
    "architecture"
  ],
  "author": "ForgeKi contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legendki7/forge-cli.git",
    "directory": "packages/workspaces"
  },
  "homepage": "https://github.com/legendki7/forge-cli#readme",
  "bugs": {
    "url": "https://github.com/legendki7/forge-cli/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "import": "./dist/generation.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/model.ts src/generation.ts src/scanner.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/model.ts src/generation.ts src/scanner.ts --format esm --dts --watch"
  },
  "dependencies": {
    "@forgecli7/core": "workspace:*",
    "@forgecli7/templates": "workspace:*"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
