{
  "name": "@forgecli/cli",
  "version": "0.1.0",
  "description": "An extensible CLI for safely scaffolding and configuring development projects.",
  "keywords": [
    "cli",
    "scaffolding",
    "typescript",
    "nextjs",
    "docker",
    "developer-tools"
  ],
  "author": "ForgeCLI contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/legendki7/forge-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/legendki7/forge-cli#readme",
  "bugs": {
    "url": "https://github.com/legendki7/forge-cli/issues"
  },
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@forgecli/core": "workspace:*",
    "@forgecli/plugins": "workspace:*",
    "@forgecli/templates": "workspace:*",
    "chalk": "^5.6.0",
    "commander": "^14.0.0",
    "inquirer": "^12.9.1"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.15.0",
  "publishConfig": {
    "access": "public"
  }
}
